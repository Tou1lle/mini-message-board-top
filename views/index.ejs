<!DOCTYPE html>
<html lang="en">

<%- include("partials/head", { title })%>

<body>
  <h1>Database</h1>
  <div class="container">

    <div class="main-container">
      <h2>Created Messages</h2>
      <div class="main-content main-index">
        <% data.forEach((message) => { %>
          <div class="index-message">
            <div class="index-top-info">
              <h3><%= message.username %></h3>
              <p class="created-date-index"><span>Created: </span> <%= message.added %></p>
            </div>
            <div class="index-bottom-info">
              <p class="index-text-message"><%= message.text %></p>
              <div class="button-container-div">
                <div class="show-index">
                  <a href="/message/<%= message.id %>">SHOW</a>
                </div>
                <div class="delete-index">
                  <a href="/delete/<%= message.id %>" onclick="return confirm('Delete message from user <%= message.username %>?')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                      <path d="M0 0h24v24H0z" fill="none" />
                      <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1.5" d="M19 8v11.6a2.4 2.4 0 0 1-2.4 2.4H7.4A2.4 2.4 0 0 1 5 19.6V8m11-3V3.2c0-.66-.54-1.2-1.2-1.2H9.2C8.54 2 8 2.54 8 3.2V5m8 0H8m8 0h5M8 5H3m9 6v6m3-6v6m-6-6v6" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <%- include("partials/navlink", { destination: "/new", name: "Create new message" }) %>

  </div>
</body>
</html>